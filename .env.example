# Copy this file to .env and fill in real values. Never commit .env.
# Load it with: uv run --env-file .env uvicorn app.main:from_env --factory

# The model provider. Without it the app runs in dry run (free; every message goes to the owner).
OPENAI_API_KEY=

# Optional. A Postgres URL for data that must last; without it, a local SQLite file (jawab.db).
# Required in single-business mode (use sqlite:///plug.db on purpose for a local try).
DATABASE_URL=

# Optional. The owner key of the seeded business, The Plug; a long random string in production.
PLUG_OWNER_KEY=

# Optional. multi (default: the public demo) or single (one business only, JAWAB_BUSINESS).
JAWAB_MODE=
JAWAB_BUSINESS=
# The deployment's name in alert subjects, e.g. "Jawab demo" or "Jawab – The Plug".
JAWAB_DEPLOYMENT=

# Optional. Websites allowed to call the API (the bubble's /health ping), comma-separated, and a regex.
JAWAB_CORS_ORIGINS=
JAWAB_CORS_ORIGIN_REGEX=

# Optional. Email through Resend. Without a key nothing is sent (it's logged instead).
RESEND_API_KEY=
# e.g. "The Plug <no-reply@theplug.cy>" once the domain is verified; Resend's test sender until then.
JAWAB_EMAIL_FROM=
# Who gets alerts: the owner (questions, offline) and the shop (complaints, leads), comma-separated.
OWNER_ALERT_EMAIL=
SHOP_ALERT_EMAILS=
